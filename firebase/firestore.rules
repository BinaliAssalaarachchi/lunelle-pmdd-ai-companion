rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Own profile only — partners never get access via these paths
    match /users/{userId} {
      allow read, write: if isUser(userId);

      match /symptomLogs/{logId} {
        allow read, write: if isUser(userId);
      }

      match /cycleEvents/{eventId} {
        allow read, write: if isUser(userId);
      }

      // Client reads only; Admin SDK (Express) writes insights
      match /insights/{insightId} {
        allow read: if isUser(userId);
        allow write: if false;
      }
    }

    // Link lifecycle and metadata are Express + Admin SDK only.
    // Client SDK must not read or write partnerLinks — all access via /api/partner/*.
    match /partnerLinks/{linkId} {
      allow read, write: if false;
    }
  }
}
