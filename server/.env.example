# Server runtime secrets — never prefix with VITE_ and never send to the client.

# Firebase Admin (optional for local demo; required to persist to Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini (required for /api/insights/generate)
GEMINI_API_KEY=

# App config
PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
# Local: leave empty to allow http://localhost:* and http://127.0.0.1:*.
# Production: set Hosting origin(s). Never use *.
# CORS_ALLOWED_ORIGINS=https://lunelle-pmdd-ai.web.app,https://lunelle-pmdd-ai.firebaseapp.com
CORS_ALLOWED_ORIGINS=

# Demo account created/updated by `npm run seed` (optional overrides).
# Must remain Maya only — do NOT add partner@demo.lunelle.app.
DEMO_ACCOUNT_EMAIL=maya@demo.lunelle.app
DEMO_ACCOUNT_PASSWORD=LunelleDemo123!
DEMO_ACCOUNT_NAME=Maya
