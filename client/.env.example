# Client build-time variables are bundled into the frontend.
# NEVER put GEMINI_API_KEY, Firebase Admin credentials, or other secrets in VITE_*.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public app URL for partner invite links (optional locally — defaults to window.location.origin)
VITE_APP_URL=

# Production Cloud Run origin for API calls (no trailing slash).
# Leave empty for local Vite dev — relative /api paths use the proxy.
# VITE_API_BASE_URL=https://lunelle-api-xxxxx.run.app
VITE_API_BASE_URL=

# Optional overrides for "Try Demo Account" (defaults match shared/constants).
# Do NOT set these to the Demo Partner address (partner@demo.lunelle.app).
VITE_DEMO_EMAIL=maya@demo.lunelle.app
VITE_DEMO_PASSWORD=LunelleDemo123!
